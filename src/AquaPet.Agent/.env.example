# Optional SQLite path. The default is %LOCALAPPDATA%\AquaPet\data\aquapet.db.
# Dates are stored as timezone-aware ISO 8601 text.
# AQUAPET_DATABASE_PATH=D:\\work\\AquaPetData\\aquapet.db

# Optional overrides for the desktop-app model settings.
# AQUAPET_LLM_TOKEN=
# AQUAPET_LLM_BASE_URL=https://api.z.ai/api/paas/v4
# AQUAPET_LLM_MODEL=glm-5.3
# AQUAPET_LLM_REASONING_EFFORT=max

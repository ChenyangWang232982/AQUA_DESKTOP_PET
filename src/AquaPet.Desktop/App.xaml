<Application x:Class="AquaPet.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_Startup"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Components/UI/PixelButton.xaml" />
        <ResourceDictionary Source="Components/UI/AquaScrollBar.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="InkBrush" Color="#142033" />
    <SolidColorBrush x:Key="NightBrush" Color="#0E1728" />
    <SolidColorBrush x:Key="PanelBrush" Color="#17243A" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="#213450" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#8ED7F8" />
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="#123B6A" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1B548E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#67E8D4" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#3BAEAA" />
    <SolidColorBrush x:Key="TextBrush" Color="#E7F5F2" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CB3C7" />
    <SolidColorBrush x:Key="WarmBrush" Color="#FFB86B" />
    </ResourceDictionary>
  </Application.Resources>
</Application>

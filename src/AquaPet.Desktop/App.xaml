<Application x:Class="AquaPet.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_Startup"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Components/UI/PixelButton.xaml" />
        <ResourceDictionary Source="Components/UI/AquaScrollBar.xaml" />
      </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="InkBrush" Color="#F1F1EE" />
    <SolidColorBrush x:Key="NightBrush" Color="#191C22" />
    <SolidColorBrush x:Key="PanelBrush" Color="#242832" />
    <SolidColorBrush x:Key="PanelLightBrush" Color="#303440" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#21252E" />
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="#E9ECE9" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#3A3E49" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4ECDC4" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#879A9D" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F1EE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B7BCBA" />
    <SolidColorBrush x:Key="WarmBrush" Color="#FFD93D" />
    </ResourceDictionary>
  </Application.Resources>
</Application>

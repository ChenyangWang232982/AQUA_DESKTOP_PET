<UserControl x:Class="AquaPet.Desktop.Components.Setting.Model.ModelSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AquaPet.Desktop.Components.UI"
             xmlns:form="clr-namespace:AquaPet.Desktop.Components.UI.Form"
             Loaded="ModelSettingsPanel_Loaded">
  <UserControl.Resources>
    <Style x:Key="InputStyle" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource NightBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="9,6" /><Setter Property="FontFamily" Value="Cascadia Mono" /></Style>
    <Style x:Key="PasswordInputStyle" TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource NightBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="9,6" /><Setter Property="FontFamily" Value="Cascadia Mono" /></Style>
    <Style x:Key="FooterSaveButton" TargetType="{x:Type ui:PixelButton}" BasedOn="{StaticResource {x:Type ui:PixelButton}}"><Setter Property="Background" Value="{StaticResource SidebarBrush}" /><Setter Property="BorderBrush" Value="#4A9EC5" /><Setter Property="Foreground" Value="#123B6A" /></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Height="360" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
      <ScrollViewer.Resources>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AquaVerticalScrollBar}" />
      </ScrollViewer.Resources>
      <StackPanel>
        <form:FormSelect x:Name="ProviderSelect" Title="选择模型" Detail="" ValueChanged="Selection_Changed" />
        <StackPanel Margin="0,14,0,0">
          <TextBlock Text="KEY TOKEN" Foreground="{StaticResource TextBrush}" FontWeight="Bold" />
          <PasswordBox x:Name="TokenInput" Style="{StaticResource PasswordInputStyle}" PasswordChanged="TokenInput_Changed" Margin="0,7,0,0" />
          <TextBlock Text="BASE URL" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,14,0,0" />
          <TextBox x:Name="BaseUrlInput" Style="{StaticResource InputStyle}" TextChanged="TextInput_Changed" Margin="0,7,0,0" />
          <TextBlock Text="模型名称" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,14,0,0" />
          <TextBox x:Name="ModelNameInput" Style="{StaticResource InputStyle}" TextChanged="TextInput_Changed" Margin="0,7,0,0" />
          <form:FormSelect x:Name="ReasoningEffortSelect" Title="REASONING EFFORT" Detail="" ValueChanged="Selection_Changed" Margin="0,14,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <ui:PixelButton x:Name="SaveButton" Content="保存" Style="{StaticResource FooterSaveButton}" Click="SaveButton_Click" IsEnabled="False" />
    </StackPanel>
  </Grid>
</UserControl>

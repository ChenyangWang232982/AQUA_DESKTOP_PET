<UserControl x:Class="AquaPet.Desktop.Components.Setting.Pet.PetSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AquaPet.Desktop.Components.UI"
             xmlns:form="clr-namespace:AquaPet.Desktop.Components.UI.Form"
             Background="Transparent" Loaded="PetSettingsPanel_Loaded">
  <UserControl.Resources>
    <Style x:Key="FooterSaveButton" TargetType="{x:Type ui:PixelButton}" BasedOn="{StaticResource {x:Type ui:PixelButton}}"><Setter Property="Background" Value="{StaticResource SidebarBrush}" /><Setter Property="BorderBrush" Value="#4A9EC5" /><Setter Property="Foreground" Value="#123B6A" /></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" Height="360" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
      <ScrollViewer.Resources>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AquaVerticalScrollBar}" />
      </ScrollViewer.Resources>
      <StackPanel>
        <form:FormToggle x:Name="EnablePetToggle" Title="启用桌宠" Detail="允许 AquaPet 显示在桌面上" IsChecked="True" ValueChanged="EnablePetToggle_ValueChanged" />
        <form:FormSelect x:Name="BehaviorModeSelect" Margin="0,12,0,0" Title="行为模式" Detail="选择桌宠自主行为的触发方式" ValueChanged="BehaviorModeSelect_ValueChanged" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,18,0,0">
      <ui:PixelButton x:Name="SaveButton" Content="保存" Style="{StaticResource FooterSaveButton}" Click="SaveButton_Click" Margin="0" IsEnabled="False" />
    </StackPanel>
  </Grid>
</UserControl>

<UserControl x:Class="AquaPet.Desktop.Components.UI.Feedback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:style="clr-namespace:AquaPet.Desktop.Components.Style"
             x:Name="Root"
             Width="300"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Visibility="Collapsed"
             Opacity="0"
             IsHitTestVisible="True">
  <UserControl.RenderTransform>
    <ScaleTransform x:Name="PopupScale" ScaleX="0.92" ScaleY="0.92" />
  </UserControl.RenderTransform>
  <Grid>
    <Border Background="#06101C" Margin="4,4,-4,-4" />
    <Border x:Name="PopupBorder" BorderBrush="White" BorderThickness="2" Padding="18" Opacity="0.85">
      <StackPanel>
        <style:TypingText x:Name="TitleTyping" AutoStart="False" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
        <style:TypingText x:Name="DetailTyping" AutoStart="False" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
